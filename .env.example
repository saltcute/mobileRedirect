# --- Telegram -----------------------------------------------------------------

# From @BotFather.
TELEGRAM_BOT_TOKEN=123456789:AAExampleTokenReplaceMe

# Numeric Telegram user IDs allowed to use the bot (comma separated).
# This is the ONLY thing preventing a stranger from sending SMS billed to your
# SIM, so it must not be empty — startup fails if it is.
# Find your ID by messaging @userinfobot.
ALLOWED_USER_IDS=123456789

# Where incoming SMS are posted. Defaults to a DM with each allowed user.
# Set this to a group/supergroup chat id (negative number) to post there instead.
#NOTIFY_CHAT_IDS=-1001234567890

# How much operational noise the bot pushes, so a headless box can be watched
# without journalctl. Cumulative: critical < normal < verbose.
#   off       nothing but incoming SMS
#   critical  only what means the gateway is not working: a port that will not
#             open, a module that vanished or stopped answering, SIM removed or
#             locked, an under-voltage report, an unauthorised access attempt
#   normal    the above, plus start/stop, modems connecting and reconnecting,
#             SIM installed, and sustained weak signal
#   verbose   the above, plus recoveries and ordinary disconnects
# These always go to ALLOWED_USER_IDS directly, never to NOTIFY_CHAT_IDS -- so a
# shared SMS group does not fill with brownout reports, and an alert never sits
# where replying to it would send an SMS.
NOTIFY_EVENTS=normal

# --- Storage ------------------------------------------------------------------

DB_PATH=./data/gateway.sqlite
# On the Pi under systemd, use the StateDirectory:
#DB_PATH=/var/lib/mobile-redirect/gateway.sqlite

# --- Modems -------------------------------------------------------------------

# Friendly names, keyed by ICCID (preferred) or IMEI. Run `npm run probe` to read
# them off the attached modules. Falls back to a generated name when unset.
#MODEM_LABELS={"8949012345678901234":"Vodafone DE","8949019876543210987":"O2 Data"}

# How often to rescan for attached/detached modules and poll for missed messages.
SCAN_INTERVAL_MS=15000

# How long to hold an incomplete multipart SMS before flushing what arrived.
CONCAT_TIMEOUT_MS=300000

# trace | debug | info | warn | error
LOG_LEVEL=info
